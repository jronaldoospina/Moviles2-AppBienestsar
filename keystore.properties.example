# Plantilla de credenciales de firma. Copia este archivo como
# "keystore.properties" (sin .example) y completa los valores.
#
#   copy keystore.properties.example keystore.properties
#
# keystore.properties esta en .gitignore y NO debe subirse nunca.
# Para CI se preferen variables de entorno:
#   BIENESTAR_STORE_FILE, BIENESTAR_STORE_PASSWORD,
#   BIENESTAR_KEY_ALIAS, BIENESTAR_KEY_PASSWORD
# Las variables de entorno tienen prioridad sobre este archivo.

storeFile=app/bienestar-release.jks
storePassword=
keyAlias=
keyPassword=