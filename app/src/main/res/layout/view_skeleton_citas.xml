<?xml version="1.0" encoding="utf-8"?>
<!-- Skeleton de la lista de citas: replica la tarjeta de cita real
     (columna de hora a la izquierda + contenido a la derecha). -->
<com.example.myapplication.ui.ShimmerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmer_citas"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
   
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <include layout="@layout/view_skeleton_cita_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include layout="@layout/view_skeleton_cita_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <include layout="@layout/view_skeleton_cita_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <include layout="@layout/view_skeleton_cita_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</com.example.myapplication.ui.ShimmerView>
