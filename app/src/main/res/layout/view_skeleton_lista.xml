<?xml version="1.0" encoding="utf-8"?>
<!-- Skeleton de lista: replica la forma de las tarjetas de usuario. -->
<com.example.myapplication.ui.ShimmerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmer_lista"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
   
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <include layout="@layout/view_skeleton_block"
            android:layout_width="180dp"
            android:layout_height="14dp" />

        <include layout="@layout/view_skeleton_block"
            android:layout_width="120dp"
            android:layout_height="12dp"
            android:layout_marginTop="6dp" />

        <!-- Fila de tarjeta -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/white_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <View
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <include layout="@layout/view_skeleton_block"
                        android:layout_width="150dp"
                        android:layout_height="14dp" />

                    <include layout="@layout/view_skeleton_block"
                        android:layout_width="110dp"
                        android:layout_height="12dp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/white_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <View
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <include layout="@layout/view_skeleton_block"
                        android:layout_width="130dp"
                        android:layout_height="14dp" />

                    <include layout="@layout/view_skeleton_block"
                        android:layout_width="160dp"
                        android:layout_height="12dp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/white_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <View
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <include layout="@layout/view_skeleton_block"
                        android:layout_width="140dp"
                        android:layout_height="14dp" />

                    <include layout="@layout/view_skeleton_block"
                        android:layout_width="100dp"
                        android:layout_height="12dp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</com.example.myapplication.ui.ShimmerView>
