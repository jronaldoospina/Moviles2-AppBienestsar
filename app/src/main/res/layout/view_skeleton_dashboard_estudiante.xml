<?xml version="1.0" encoding="utf-8"?>
<!-- Skeleton del Inicio del estudiante. Muestra la forma del contenido
     mientras llegan los datos, en vez de un spinner. -->
<com.example.myapplication.ui.ShimmerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmer_dashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
   
    android:visibility="gone">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Tarjeta del semaforo -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white_card"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        />

                    <View
                        android:layout_width="160dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="14dp"
                        />

                    <View
                        android:layout_width="220dp"
                        android:layout_height="12dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Fila de KPIs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <include layout="@layout/view_skeleton_block"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1" />

                <include layout="@layout/view_skeleton_block"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1" />

                <include layout="@layout/view_skeleton_block"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- Proxima cita -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/white_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <include layout="@layout/view_skeleton_block"
                        android:layout_width="120dp"
                        android:layout_height="12dp" />

                    <include layout="@layout/view_skeleton_block"
                        android:layout_width="match_parent"
                        android:layout_height="14dp"
                        android:layout_marginTop="12dp" />

                    <include layout="@layout/view_skeleton_block"
                        android:layout_width="180dp"
                        android:layout_height="12dp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Accesos rapidos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <include layout="@layout/view_skeleton_block"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1" />

                <include layout="@layout/view_skeleton_block"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</com.example.myapplication.ui.ShimmerView>
