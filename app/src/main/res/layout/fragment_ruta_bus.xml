<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_gray">

    <!-- ==================== MAPA (fondo completo) ==================== -->
    <org.osmdroid.views.MapView
        android:id="@+id/map_ruta"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ==================== HEADER SUPERIOR (overlay) ==================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_margin="12dp"
        app:cardBackgroundColor="@color/white_card"
        app:cardCornerRadius="18dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/divider_color"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Fila titulo + chip de estado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/badge_circle_green" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Ruta Bus UPC"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_badge_fuente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_info"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="OpenStreetMap"
                    android:textColor="@color/info_text"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Horarios en dos columnas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RECOGIDA"
                        android:textColor="@color/text_hint"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txt_horario_recogida"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="05:00 AM / 01:00 PM"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/divider_color" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SALIDA UPC"
                        android:textColor="@color/text_hint"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txt_horario_salida"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12:00 M / 06:00 P"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Resultado: parada mas cercana -->
            <TextView
                android:id="@+id/txt_parada_cercana"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/gray_light"
                android:lineSpacingExtra="2dp"
                android:padding="12dp"
                android:text="Pulsa el botón de ubicación del mapa para ver si la ruta te sirve."
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ==================== FAB UBICACION (sobre el mapa) ==================== -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_mi_ubicacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/card_lista"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="Mi ubicacion"
        android:src="@drawable/ic_mi_ubicacion"
        app:backgroundTint="@color/green_primary"
        app:tint="@color/white_card" />

    <!-- ==================== LISTA DE PARADAS (inferior) ==================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_lista"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:layout_alignParentBottom="true"
        app:cardBackgroundColor="@color/white_card"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Handle indicador -->
            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:background="@drawable/badge_circle_white" />

            <!-- Barra de acciones: "Ver ruta" es la accion principal (boton
                     solido, mas ancho); UPC y Compartir son secundarias.
                     Mi ubicacion vive en el FAB sobre el mapa. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ver_ruta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.05"
                    android:maxLines="1"
                    android:minHeight="46dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="Ver ruta"
                    android:textAllCaps="false"
                    android:textColor="@color/on_green"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/green_primary"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ver_upc"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1.15"
                    android:maxLines="1"
                    android:minHeight="46dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="Sede UPC"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_event"
                    app:iconGravity="textStart"
                    app:iconSize="15dp"
                    app:iconTint="@color/green_primary"
                    app:iconPadding="3dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_compartir"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1.15"
                    android:maxLines="1"
                    android:minHeight="46dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="Compartir"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_send"
                    app:iconGravity="textStart"
                    app:iconSize="15dp"
                    app:iconTint="@color/green_primary"
                    app:iconPadding="3dp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_paradas"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="8dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>