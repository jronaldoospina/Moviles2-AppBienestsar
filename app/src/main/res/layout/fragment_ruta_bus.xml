<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
   >

    <!-- ==================== MAPA (fondo completo) ==================== -->
    <org.osmdroid.views.MapView
        android:id="@+id/map_ruta"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ==================== BARRA SUPERIOR COMPACTA (overlay) ====================
         El detalle de la ruta (horarios, paradas, resumen) vive en una hoja
         inferior que abre el boton de menu. Asi el mapa conserva la pantalla
         casi completa y la vista del recorrido sigue siendo lo principal. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        app:cardBackgroundColor="@color/white_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:strokeColor="@color/divider_color"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp">

            <!-- Menu hamburguesa: abre el detalle de la ruta -->
            <ImageButton
                android:id="@+id/btn_menu_ruta"
                android:layout_width="44dp"
                android:layout_height="44dp"
               
                android:contentDescription="Ver informacion de la ruta"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="@color/text_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ruta Bus UPC"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Resumen en una sola linea; el resto va en la hoja -->
                <TextView
                    android:id="@+id/txt_resumen_compacto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="9 paradas · OpenStreetMap"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_badge_fuente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
               
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="OSM"
                android:textColor="@color/info_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ==================== AVISO DE PARADA CERCANA (overlay compacto) ============ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_cercana"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/card_header"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/white_card"
        app:cardCornerRadius="14dp"
        app:cardElevation="4dp"
        app:strokeColor="@color/divider_color"
        app:strokeWidth="1dp">

        <TextView
            android:id="@+id/txt_parada_cercana"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:padding="12dp"
            android:text="Pulsa el botón de ubicación para ver si la ruta te sirve."
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- ==================== FAB UBICACION (sobre el mapa) ==================== -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_mi_ubicacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/card_lista"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="Mi ubicacion"
        android:src="@drawable/ic_mi_ubicacion"
        app:backgroundTint="@color/green_primary"
        app:tint="@color/white_card" />

    <!-- ==================== LISTA DE PARADAS (inferior) ==================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_lista"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:layout_alignParentBottom="true"
        app:cardBackgroundColor="@color/white_card"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Handle indicador -->
            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
               
                android:backgroundTint="@color/divider_color" />

            <!-- Barra de acciones: "Ver ruta" es la accion principal (boton
                     solido, mas ancho); UPC y Compartir son secundarias.
                     Mi ubicacion vive en el FAB sobre el mapa. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ver_ruta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.05"
                    android:maxLines="1"
                    android:minHeight="46dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="Ver ruta"
                    android:textAllCaps="false"
                    android:textColor="@color/on_green"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/green_primary"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ver_upc"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1.15"
                    android:maxLines="1"
                    android:minHeight="46dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="Sede UPC"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_event"
                    app:iconGravity="textStart"
                    app:iconSize="15dp"
                    app:iconTint="@color/green_primary"
                    app:iconPadding="3dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_compartir"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1.15"
                    android:maxLines="1"
                    android:minHeight="46dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="Compartir"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_send"
                    app:iconGravity="textStart"
                    app:iconSize="15dp"
                    app:iconTint="@color/green_primary"
                    app:iconPadding="3dp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_paradas"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="8dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>
