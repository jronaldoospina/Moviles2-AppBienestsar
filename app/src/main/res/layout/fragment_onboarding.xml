<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_gray"
    android:gravity="center"
    android:padding="24dp">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_margin="24dp"
        android:src="@drawable/ic_launcher_foreground"
        android:contentDescription="Onboarding Icon" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Ruta Bus UPC Aguachica"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Visualiza la ruta oficial del bus, sus 9 paradas y la sede UPC.\nUsa OpenStreetMap (sin costo ni API key)."
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:textAlignment="center" />

    <Button
        android:id="@+id/btn_empezar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:text="Empezar"
        android:textColor="@color/on_green"
        android:background="@color/green_primary" />
</LinearLayout>