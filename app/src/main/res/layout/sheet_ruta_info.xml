<?xml version="1.0" encoding="utf-8"?>
<!-- Contenido del menu hamburguesa de la Ruta. Se muestra en un BottomSheet
     para no tapar el mapa: el encabezado queda como barra compacta y el
     detalle vive aqui. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
   
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <!-- Horarios -->
    <TextView
        style="@style/TituloSeccion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/txt_horarios" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/EtiquetaSeccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/txt_recogida" />

            <TextView
                android:id="@+id/txt_horario_recogida_menu"
                style="@style/ValorSeccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/txt_05_00_a_m_01_00_p_m" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/EtiquetaSeccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/txt_salida_upc" />

            <TextView
                android:id="@+id/txt_horario_salida_menu"
                style="@style/ValorSeccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/txt_12_00_m_06_00_p_m" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="18dp"
        />

    <!-- Resumen del recorrido -->
    <TextView
        style="@style/TituloSeccion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/txt_recorrido" />

    <TextView
        android:id="@+id/txt_resumen_ruta"
        style="@style/ValorSeccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/txt_9_paradas_hasta_la_sede_upc" />

    <!-- Paradas -->
    <TextView
        style="@style/TituloSeccion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/txt_paradas" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/txt_paradas_ruta_menu"
            style="@style/ValorSeccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:text="@string/txt_cargando_paradas" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="18dp"
        />

    <!-- Origen de los datos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
       
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/txt_mapa_y_ruta_sobre_openstreetmap_sin_api_key_ni_c"
            android:textColor="@color/text_hint"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/txt_fuente_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/txt_osm"
            android:textColor="@color/info_text"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>

