<resources>
    <!-- Toolbar -->
    <style name="ToolbarTitleStyle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- Bottom Navigation -->
    <style name="BottomNavigationStyle" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/white_card</item>
        <item name="itemIconSize">24dp</item>
        <item name="itemRippleColor">@color/green_light</item>
        <item name="elevation">8dp</item>
    </style>

    <!-- TextInputLayout (OutlinedBox) — global default -->
    <style name="Widget.BienestarUPC.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxStrokeColor">@color/green_primary</item>
        <item name="hintTextColor">@color/green_primary</item>
        <item name="hintTextAppearance">@style/TextAppearance.Material3.BodyMedium</item>
        <item name="cursorColor">@color/green_primary</item>
        <item name="endIconTint">@color/gray_medium</item>
        <item name="startIconTint">@color/gray_medium</item>
    </style>

    <!-- Buttons: base -->
    <style name="Widget.BienestarUPC.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/green_primary</item>
        <item name="android:textColor">@color/white_card</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="elevation">0dp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Widget.BienestarUPC.Button.Primary" parent="Widget.BienestarUPC.Button" />

    <style name="Widget.BienestarUPC.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/green_primary</item>
        <item name="android:textColor">@color/green_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.BienestarUPC.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/green_container</item>
        <item name="android:textColor">@color/on_primary_container</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Cards -->
    <style name="Widget.BienestarUPC.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">1dp</item>
        <item name="cardBackgroundColor">@color/white_card</item>
        <item name="strokeColor">@color/stroke_color</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/green_light</item>
    </style>

    <style name="Widget.BienestarUPC.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/white_card</item>
        <item name="strokeColor">@color/surface_outline_variant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Chips -->
    <style name="Widget.BienestarUPC.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">20dp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">@color/stroke_color</item>
    </style>

    <!-- Snackbar -->
    <style name="Widget.BienestarUPC.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">@color/text_primary</item>
        <item name="android:textColor">@color/white_card</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.BienestarUPC.Snackbar</item>
    </style>

    <style name="ShapeAppearance.BienestarUPC.Snackbar" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>
</resources>